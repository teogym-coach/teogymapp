rules_version = '2';

// ═══════════════════════════════════════════════════════════════
//  TEO GYM — Firestore 보안 규칙 v9 (2026-07 회원 실배포 보안 감사)
//
//  회원앱 원칙:
//    - 대표자: members/{memberId}.trainerUid == request.auth.uid 인 데이터 접근
//    - 회원 본인: members/{memberId}.memberUid == request.auth.uid
//               이면서 status == "active" (진행중) 인 회원만 접근 허용
//    - 휴식중(paused) / 종료(ended) / 상태값 없음 / 알 수 없는 상태 → 회원 self-access 차단
//    - 수업일지는 회원 본인에게 isPublished == true 일 때만 공개
//    - 개인운동(personalWorkouts)은 방향이 반대다: 회원이 쓰고 트레이너는 읽기만 한다(§personalWorkouts)
//
//  검증은 반드시 request.auth.uid 기준(uid()) — 클라이언트가 보낸 memberId/이메일 값은
//  절대 신뢰하지 않고, 항상 memberDoc(memberId).memberUid == uid() 형태로 서버측 데이터와 대조한다.
//
//  테스트 가능한 시나리오 — tests/rules/firestore.rules.test.mjs (npm run test:rules)에 대응 테스트 존재:
//    1. 회원 A가 회원 B의 memberId로 get/list 시도 → members get 차단 (§1 "다른 회원 문서 get 차단")
//    2. 회원 A가 개발자 도구에서 memberId를 바꿔 sessions/bodyCheck/nutrition 등에 쓰기 시도
//       → 전부 isTrainerOfMember/isMemberSelfActive가 memberDoc(memberId).memberUid를 실제로 조회해
//         request.auth.uid와 대조하므로, 클라이언트가 보낸 memberId가 본인 것이 아니면 차단됨
//    3. isPublished == false 인 세션은 회원 자신의 세션이라도 read 차단 (§2 "비공개 세션 read 차단")
//    4. 휴식중(paused)/종료(ended)/상태 불명 회원은 본인 문서라도 전 컬렉션 접근 차단 (§1, §2, §4~9)
//    5. 관리자(trainerUid 일치)는 본인이 담당하는 회원 전체에 대해 read/write 가능,
//       타 트레이너 회원 문서는 차단 (§1 "타 트레이너 회원 get/delete 차단")
//    6. 회원은 memberProfileUpdateKeysAllowed()에 없는 필드(trainerUid/memberUid/isOwner 등) 수정 불가
// ═══════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function memberDoc(memberId) {
      return get(/databases/$(database)/documents/members/$(memberId)).data;
    }

    function isTrainerData(data) {
      return isSignedIn() && data.get('trainerUid', '') == uid();
    }

    function isMemberUidData(data) {
      return isSignedIn() && data.get('memberUid', '') == uid();
    }

    // 진행중 상태 확인: active 계열 값만 허용
    // status/memberStatus 필드 없으면(== '') active 간주 — 관리자앱 기본값(m.status||"active")과 동일
    // paused/ended 등 명시적 비활성 값이 있을 때만 차단
    function isMemberStatusActive(data) {
      let s = data.get('status', '');
      let ms = data.get('memberStatus', '');
      return (s == '' && ms == '')
          || s == "active" || ms == "active"
          || s == "pt" || ms == "pt"
          || s == "pt_active" || ms == "pt_active"
          || s == "in_progress" || ms == "in_progress"
          || s == "진행중" || ms == "진행중"
          || s == "진행" || ms == "진행"
          || s == "pt진행" || ms == "pt진행"
          || s == "pt 진행중" || ms == "pt 진행중";
    }

    function canReadMemberData(data) {
      return isTrainerData(data)
          || (isMemberUidData(data) && isMemberStatusActive(data));
    }

    function isTrainerOfMember(memberId) {
      return isTrainerData(memberDoc(memberId));
    }

    // uid 일치만 확인 (상태 무관) — 내부 헬퍼로만 사용
    function isMemberSelf(memberId) {
      let m = memberDoc(memberId);
      return isMemberUidData(m);
    }

    // uid 일치 + 진행중 상태 확인 — 회원 self-access 게이트
    function isMemberSelfActive(memberId) {
      let m = memberDoc(memberId);
      return isMemberUidData(m) && isMemberStatusActive(m);
    }

    // 관리자 OR 진행중 회원 본인
    function canAccessMember(memberId) {
      return isTrainerOfMember(memberId) || isMemberSelfActive(memberId);
    }

    // ── 아래 4개는 보안 감사 요청에 따라 이름을 명시적으로 정리한 헬퍼(기존 로직의 별칭) ──
    // isVerifiedTrainer()는 settings/trainers.uids 목록으로 검증된 "진짜 트레이너 계정"인지 확인한다.
    // (member 문서 단위 소유권 확인은 isTrainerOfMember/isOwner를 쓴다 — 전역 admin과 개념이 다름)
    function isAdmin() {
      return isVerifiedTrainer();
    }

    // memberId를 "소유"한 트레이너인지 확인. 주의: 앱 코드의 member.isOwner 필드(대표 개인 기록용 owner
    // 회원 플래그)와는 다른 개념이다 — 여기서 isOwner(memberId)는 "이 회원 데이터의 트레이너 소유자"를 뜻한다.
    function isOwner(memberId) {
      return isTrainerOfMember(memberId);
    }

    // 세션 1건을 회원 본인이 읽을 수 있는지 — 공개(isPublished)된 것만 허용
    function canReadSession(memberId, sessionData) {
      return isTrainerOfMember(memberId)
          || (isMemberSelfActive(memberId) && sessionData.get('isPublished', false) == true);
    }

    // private 서브컬렉션(memo/ticketInfo 등 회원에게 절대 노출되면 안 되는 필드) — 트레이너만 write 가능
    function canWriteMemberPrivateData(memberId) {
      return isTrainerOfMember(memberId);
    }

    function isPublishedData(data) {
      return (data.get('status', '') == "published" || data.get('published', false) == true || data.get('isPublished', false) == true)
        && data.get('visible', true) != false
        && data.get('visibility', '') != "hidden";
    }

    // settings/trainers 문서에 등록된 트레이너 uid인지 검증
    // 회원 계정은 이 목록에 없으므로 pairSessions·notices 생성·수정·삭제 불가
    function isVerifiedTrainer() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/settings/trainers)
        && uid() in get(/databases/$(database)/documents/settings/trainers).data.uids;
    }

    function memberProfileUpdateKeysAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "workoutFrequency", "weeklyWorkoutCount", "height", "startWeight", "currentWeight", "targetWeight", "targetWeightKg", "goal", "goalPeriod", "goalPeriodType", "goalDeadline", "targetDate", "customGoalDate", "memberAppLastLoginAt", "updatedAt",
        "birthYear", "birthMonth", "birthDay", "birthYearMonth", "birthSource",
        "fcmToken", "fcmTokenUpdatedAt",
        "memberLastInputAt", "todayInputTypes", "recentActivityLog",
        // 온보딩 상태 미러(회원 목록 배지용 캐시) — 원본은 members/{id}/memberOnboarding/main
        "onboardingStatus", "onboardingCompletedAt", "onboardingUpdatedAt", "onboardingHasCaution",
        "survey"
      ]) && memberSurveySyncKeysAllowed();
    }

    // 온보딩 완료 시 회원 본인이 survey 맵에 쓸 수 있는 필드를 gender/height/weight/age로만 제한
    // (관리자 상담 설문의 나머지 필드 — 통증/운동경험/방문계기/생활습관 등 — 는 회원이 직접 쓸 수 없음)
    function memberSurveySyncKeysAllowed() {
      return !("survey" in request.resource.data.diff(resource.data).affectedKeys())
        || request.resource.data.survey.diff(resource.data.get('survey', {})).affectedKeys().hasOnly(["gender", "height", "weight", "age"]);
    }

    function memberOnboardingProfileKeysAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "gender", "birthYear", "birthMonth", "birthDay", "birthYearMonth", "jobType", "averageWorkoutTime", "averageSteps", "focusAreas",
        "completed", "completedAt", "weightHistoryMode", "calorieHistoryMode", "weightHistoryModeStartedAt", "calorieHistoryModeStartedAt",
        "weightHistoryModeTransferredAt", "calorieHistoryModeTransferredAt",
        "weeklyWorkoutCount", "workoutFrequency", "goal", "heightCm", "height",
        "startingWeightKg", "startWeight", "currentWeightKg", "currentWeight", "weight", "targetWeight", "targetWeightKg",
        "targetPeriod", "targetPeriodCustom", "goalPeriod", "goalPeriodType", "goalDeadline", "targetDate", "customGoalDate", "updatedAt",
        "agreedTermsAt", "agreedPrivacyAt", "restingHeartRate", "goalHistory",
        "v2", "v2Draft", "onboardingVersion", "startedAt"
      ]);
    }

    function memberOnboardingCreateKeysAllowed() {
      return request.resource.data.keys().hasOnly([
        "gender", "birthYear", "birthMonth", "birthDay", "birthYearMonth", "jobType", "averageWorkoutTime", "averageSteps", "focusAreas",
        "completed", "completedAt", "weightHistoryMode", "calorieHistoryMode", "weightHistoryModeStartedAt", "calorieHistoryModeStartedAt",
        "weightHistoryModeTransferredAt", "calorieHistoryModeTransferredAt",
        "weeklyWorkoutCount", "workoutFrequency", "goal", "heightCm", "height",
        "startingWeightKg", "startWeight", "currentWeightKg", "currentWeight", "weight", "targetWeight", "targetWeightKg",
        "targetPeriod", "targetPeriodCustom", "goalPeriod", "goalPeriodType", "goalDeadline", "targetDate", "customGoalDate", "updatedAt",
        "agreedTermsAt", "agreedPrivacyAt", "restingHeartRate", "goalHistory",
        "v2", "v2Draft", "onboardingVersion", "startedAt"
      ]);
    }

    // memberNotifications — 회원 본인은 isRead/readAt만 수정 가능(알림 읽음 처리), 생성/삭제는 트레이너만
    function memberNotificationUpdateKeysAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isRead", "readAt"]);
    }

    function bodyCheckProfileUpdateKeysAllowed() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "records", "goal", "inbody", "updatedAt", "currentWeight", "weight", "targetWeight", "targetWeightKg"
      ]);
    }

    function bodyCheckProfileCreateKeysAllowed() {
      return request.resource.data.keys().hasOnly([
        "records", "goal", "inbody", "updatedAt", "currentWeight", "weight", "targetWeight", "targetWeightKg"
      ]);
    }

    // 개인운동 파생 합계 검증 — 숫자 타입 + 비음수 + 상한(운동 20종목 × 세트 20개 기준으로도 넘을 수 없는 값).
    // 개별 세트의 중량·횟수는 Rules에서 배열 순회가 불가능해 검증할 수 없으므로, 합계 범위로 비정상 문서를 막는다.
    function personalWorkoutTotalsValid(data) {
      return data.totalExercises is number && data.totalExercises >= 0 && data.totalExercises <= 20
          && data.totalSets is number && data.totalSets >= 0 && data.totalSets <= 400
          && data.totalVolume is number && data.totalVolume >= 0 && data.totalVolume <= 4000000
          && (!("durationMinutes" in data) || (data.durationMinutes is number && data.durationMinutes >= 0 && data.durationMinutes <= 1440))
          && (!("exerciseKeys" in data) || (data.exerciseKeys is list && data.exerciseKeys.size() <= 20));
    }

    // 완료된 개인운동 수정(§personalWorkouts 완료 후 수정) — rpe는 미입력(null) 또는 1~10 정수만,
    // startedAt/endedAt은 둘 다 있으면 반드시 시작 < 종료(운동 시간이 음수가 될 수 없음).
    function personalWorkoutRpeValid(data) {
      return !("rpe" in data) || data.rpe == null || (data.rpe is int && data.rpe >= 1 && data.rpe <= 10);
    }
    function personalWorkoutTimeOrderValid(data) {
      return !("startedAt" in data) || !("endedAt" in data) || data.startedAt < data.endedAt;
    }
    // rpeUpdatedAt은 rpe와 항상 같이 바뀌어야 한다 — 내용만 수정했는데 rpe 입력 시각이 조작되는 것을 막는다.
    function personalWorkoutRpeTimestampPaired(before, after) {
      return !(("rpeUpdatedAt" in after.diff(before).affectedKeys())) || ("rpe" in after.diff(before).affectedKeys());
    }

    // 개인운동 근육통(§personalWorkoutSoreness) 데이터 검증 — bodyParts[] 원소 내부(부위 중복 등)는
    // exercises[]와 마찬가지로 Rules에서 배열 순회가 불가능해 검증할 수 없다(클라이언트 책임, size만 상한).
    function personalWorkoutSorenessDataValid(data) {
      return data.workoutDate is string && data.workoutDate.size() == 10
          && (data.timing == "next_day" || data.timing == "two_days_later")
          && data.daysAfterWorkout == (data.timing == "two_days_later" ? 2 : 1)
          && data.overallLevel is int && data.overallLevel >= 0 && data.overallLevel <= 5
          && data.bodyParts is list && data.bodyParts.size() <= 4
          && data.memo is string && data.memo.size() <= 1000;
    }

    function isTargetMemberSelf(targetMemberId) {
      return exists(/databases/$(database)/documents/members/$(targetMemberId))
        && get(/databases/$(database)/documents/members/$(targetMemberId)).data.memberUid == uid();
    }

    match /members/{memberId} {

      // get/list: 관리자(trainerUid) + 진행중 회원 본인(memberUid + status==active)
      allow get, list: if canReadMemberData(resource.data);

      // 생성: 반드시 내 uid로 trainerUid 설정
      allow create: if isSignedIn()
                    && request.resource.data.trainerUid == uid();

      // 수정: 관리자 전체 관리 / 진행중 회원 본인은 허용된 프로필 필드만
      allow update: if isSignedIn()
                    && (
                      (resource.data.trainerUid == uid()
                        && request.resource.data.trainerUid == uid())
                      || (resource.data.memberUid == uid()
                          && isMemberStatusActive(resource.data)
                          && request.auth != null
                          && memberProfileUpdateKeysAllowed())
                    );

      allow delete: if isSignedIn()
                    && resource.data.trainerUid == uid();

      match /sessions/{sessionId} {
        allow read: if canReadSession(memberId, resource.data);
        allow create, delete: if isTrainerOfMember(memberId);
        allow update: if isTrainerOfMember(memberId)
                      || (isMemberSelfActive(memberId)
                          && resource.data.isPublished == true
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["sorenessReport", "sorenessUpdatedAt"]));

        match /memberFeedback/{feedbackUid} {
          allow read: if isTrainerOfMember(memberId)
                      || (isMemberSelfActive(memberId) && feedbackUid == uid());
          allow create, update: if isTrainerOfMember(memberId)
                                || (isMemberSelfActive(memberId)
                                    && feedbackUid == uid()
                                    && request.resource.data.source == "memberApp"
                                    && request.resource.data.keys().hasOnly(["sorenessLevel", "sorenessBodyPart", "sorenessBodyParts", "sorenessNature", "rpe", "memo", "createdAt", "updatedAt", "source"]));
          allow delete: if isTrainerOfMember(memberId);
        }
      }

      match /memberCheckins/{checkinId} {
        allow read, create, update: if canAccessMember(memberId);
        allow delete: if canAccessMember(memberId);
      }

      match /cardioLogs/{logId} {
        allow read, create, update: if canAccessMember(memberId);
        allow delete: if canAccessMember(memberId);
      }

      // PT 잔여 횟수 재등록·보정 이력 — 관리자 전용(회원은 읽기도 불가).
      // cardioLogs/memberCheckins와 달리 canAccessMember(회원 본인 포함)를 쓰지 않는다:
      // 잔여 횟수·재등록 이력은 현재 단계에서 회원앱에 전혀 노출하지 않는 관리자 운영 데이터다.
      // 기준값(ptBalanceInitialized/ptBalanceBaselineAt/ptBalanceBaselineRemaining/
      // ptBalanceBaselineRenewalCount)과 홈 회원 목록 표시용 잔여 캐시(ptBalanceRemaining/
      // ptBalanceRawRemaining/ptBalanceRenewalCount)는 members 문서 필드이며,
      // memberProfileUpdateKeysAllowed() 화이트리스트에 없으므로 회원 본인 계정으로는
      // 어떤 경로로도 수정할 수 없다(잔여 횟수 조작 차단).
      match /ptRegistrations/{registrationId} {
        allow read, create, update, delete: if isTrainerOfMember(memberId);
      }

      // 개인운동 기록 — 회원이 직접 작성하고 트레이너는 읽기만 한다(1차 범위: 관리자 수정·삭제 없음).
      // 권한 방향이 sessions(트레이너 작성 → 회원 열람)와 정반대라 반드시 별도 컬렉션으로 분리되어 있다.
      //
      // 회원 쓰기 방어선:
      //   - isMemberSelfActive(memberId): memberUid == auth.uid 인 진행중 회원 본인만 (경로·memberId 위조 차단)
      //   - memberId 필드 == 경로 memberId (다른 회원 id 위조 저장 차단)
      //   - 생성 시 status는 반드시 "in_progress" (완료 기록을 우회 생성해 관리자 화면에 꽂는 것 차단)
      //   - 허용 필드 화이트리스트 + 타입 검증(배열/문자열/숫자)
      //   - exercises 배열 최대 20개, memo 최대 1000자, workoutParts 최대 4개
      //   - memberId/createdAt은 생성 이후 영원히 변경 불가
      //   - completedAt은 완료 전환(1회)에서만 생기고 이후 재변경 불가
      //   - 완료된 기록은 화이트리스트로 제한된 필드(날짜·시작/종료시각·부위·종목·메모·집계·rpe)만 회원 본인이 재수정 가능,
      //     completed → in_progress 역행은 어떤 경로로도 불가
      // 주의: Firestore Rules에는 배열 순회가 없어 exercises[] 각 원소 내부(중량·횟수) 검증은 불가능하다.
      //       세트 단위 숫자 범위 검증은 클라이언트(normalizePersonalWorkoutExercise)에서 하고,
      //       Rules는 배열 크기 + 파생 합계(totalSets/totalVolume) 범위로 비정상 문서를 막는다.
      match /personalWorkouts/{workoutId} {
        allow read: if isTrainerOfMember(memberId) || isMemberSelfActive(memberId);

        allow create: if isMemberSelfActive(memberId)
                      && request.resource.data.memberId == memberId
                      && request.resource.data.status == "in_progress"
                      && request.resource.data.keys().hasOnly([
                           "memberId", "workoutDate", "workoutParts", "exercises", "exerciseKeys",
                           "memo", "totalExercises", "totalSets", "totalVolume",
                           "status", "source", "startedAt", "createdAt", "updatedAt"
                         ])
                      && request.resource.data.workoutDate is string
                      && request.resource.data.workoutDate.size() == 10
                      && request.resource.data.workoutParts is list
                      && request.resource.data.workoutParts.size() <= 4
                      && request.resource.data.exercises is list
                      && request.resource.data.exercises.size() <= 20
                      && request.resource.data.memo is string
                      && request.resource.data.memo.size() <= 1000
                      && personalWorkoutTotalsValid(request.resource.data);

        // 진행 중 기록의 내용 갱신 — 허용 필드만, status는 in_progress 유지 또는 completed로 1회 전환
        // (기존 경로 그대로 — 완료 전환 순간까지는 날짜·시작시각·작성자 필드를 절대 건드릴 수 없다)
        allow update: if isMemberSelfActive(memberId)
                      && resource.data.memberId == memberId
                      && resource.data.status == "in_progress"
                      && request.resource.data.memberId == memberId
                      && request.resource.data.workoutDate == resource.data.workoutDate
                      && request.resource.data.startedAt == resource.data.startedAt
                      && request.resource.data.createdAt == resource.data.createdAt
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                           "workoutParts", "exercises", "exerciseKeys", "memo",
                           "totalExercises", "totalSets", "totalVolume", "durationMinutes",
                           "status", "endedAt", "completedAt", "updatedAt", "rpe", "rpeUpdatedAt"
                         ])
                      && (request.resource.data.status == "in_progress" || request.resource.data.status == "completed")
                      && request.resource.data.workoutParts is list
                      && request.resource.data.workoutParts.size() <= 4
                      && request.resource.data.exercises is list
                      && request.resource.data.exercises.size() <= 20
                      && request.resource.data.memo is string
                      && request.resource.data.memo.size() <= 1000
                      && personalWorkoutTotalsValid(request.resource.data)
                      // 운동 종료(완료 전환) 시점에 최종 RPE를 함께 저장할 수 있게 허용 — 완료 후 수정 branch와 동일한 검증 재사용.
                      && personalWorkoutRpeValid(request.resource.data)
                      && personalWorkoutRpeTimestampPaired(resource.data, request.resource.data)

                      // 완료된 기록의 재수정 — 회원 본인이 날짜·시작/종료시각·부위·종목·메모·집계·RPE를 화이트리스트로만 고칠 수 있다.
                      // memberId/createdAt은 화이트리스트에서 아예 빠져 있어 diff에 나타나는 순간 hasOnly가 실패한다(위조 차단).
                      // status는 반드시 "completed" 유지(diff에 없거나 있어도 completed와 같아야 함) — in_progress 역행 차단.
                      || (isMemberSelfActive(memberId)
                      && resource.data.memberId == memberId
                      && resource.data.status == "completed"
                      && request.resource.data.memberId == memberId
                      && request.resource.data.createdAt == resource.data.createdAt
                      && request.resource.data.status == "completed"
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                           "workoutDate", "startedAt", "endedAt", "workoutParts", "exercises", "exerciseKeys",
                           "memo", "totalExercises", "totalSets", "totalVolume", "durationMinutes",
                           "rpe", "rpeUpdatedAt", "updatedAt"
                         ])
                      && request.resource.data.workoutDate is string
                      && request.resource.data.workoutDate.size() == 10
                      && request.resource.data.workoutParts is list
                      && request.resource.data.workoutParts.size() <= 4
                      && request.resource.data.exercises is list
                      && request.resource.data.exercises.size() <= 20
                      && request.resource.data.memo is string
                      && request.resource.data.memo.size() <= 1000
                      && personalWorkoutTotalsValid(request.resource.data)
                      && personalWorkoutRpeValid(request.resource.data)
                      && personalWorkoutTimeOrderValid(request.resource.data)
                      && personalWorkoutRpeTimestampPaired(resource.data, request.resource.data));

        // 회원 본인은 자기 기록만 삭제 가능(진행 중 폐기 + 완료 기록 삭제) · 트레이너도 정리 목적으로 삭제 허용
        allow delete: if isTrainerOfMember(memberId) || isMemberSelfActive(memberId);
      }

      // 개인운동 후 근육통 — members/{memberId}/personalWorkoutSoreness/{workoutId}.
      // 문서ID를 개인운동 workoutId와 동일하게 고정해 "개인운동 1건당 근육통 1건"을 구조로 보장한다(중복 문서 자체 불가).
      // PT 수업 근육통(sessions.memberFeedback)과 컬렉션·경로가 완전히 분리되어 있어 두 출처가 섞이지 않는다.
      match /personalWorkoutSoreness/{workoutId} {
        allow read: if isTrainerOfMember(memberId) || isMemberSelfActive(memberId);

        // 참조하는 개인운동이 실제로 이 회원 소유의 "완료된" 기록인지 서버측에서 대조한다(위조된 workoutId 차단).
        allow create: if isMemberSelfActive(memberId)
                      && request.resource.data.memberId == memberId
                      && request.resource.data.workoutId == workoutId
                      && request.resource.data.source == "personalWorkout"
                      && exists(/databases/$(database)/documents/members/$(memberId)/personalWorkouts/$(workoutId))
                      && get(/databases/$(database)/documents/members/$(memberId)/personalWorkouts/$(workoutId)).data.memberId == memberId
                      && get(/databases/$(database)/documents/members/$(memberId)/personalWorkouts/$(workoutId)).data.status == "completed"
                      && request.resource.data.keys().hasOnly([
                           "memberId", "workoutId", "workoutDate", "timing", "daysAfterWorkout",
                           "overallLevel", "bodyParts", "memo", "source",
                           "recordedAt", "createdAt", "updatedAt"
                         ])
                      && personalWorkoutSorenessDataValid(request.resource.data);

        // 수정 — timing/근육통 값/메모만 바꿀 수 있다. memberId/workoutId/source/createdAt은 영원히 불변.
        allow update: if isMemberSelfActive(memberId)
                      && resource.data.memberId == memberId
                      && request.resource.data.memberId == memberId
                      && request.resource.data.workoutId == workoutId
                      && request.resource.data.source == "personalWorkout"
                      && request.resource.data.createdAt == resource.data.createdAt
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                           "timing", "daysAfterWorkout", "overallLevel", "bodyParts", "memo", "updatedAt"
                         ])
                      && personalWorkoutSorenessDataValid(request.resource.data);

        allow delete: if isTrainerOfMember(memberId) || isMemberSelfActive(memberId);
      }

      match /memberMessages/{messageId} {
        allow read, create, update: if canAccessMember(memberId);
        allow delete: if isTrainerOfMember(memberId);
      }

      match /attendance/{dateId} {
        allow read: if isTrainerOfMember(memberId) || isMemberSelfActive(memberId);
        allow create: if isMemberSelfActive(memberId)
                      && request.resource.data.keys().hasOnly(["date", "createdAt", "updatedAt", "source"])
                      && request.resource.data.date == dateId;
        allow update: if false;
        // 회원 본인(진행중)도 자기 운동 체크를 취소(삭제)할 수 있다 — attendance는 회원 셀프 체크 기록.
        // update는 여전히 false라 내용 변조는 불가하고, 재생성 시에도 create 규칙(필드 4개 + date==docId)이 그대로 적용된다.
        allow delete: if isTrainerOfMember(memberId) || isMemberSelfActive(memberId);
      }

      match /readSessions/{sessionId} {
        allow read: if isTrainerOfMember(memberId) || isMemberSelfActive(memberId);
        allow create, update: if isMemberSelfActive(memberId)
                              && request.resource.data.keys().hasOnly(["readAt"]);
        allow delete: if isTrainerOfMember(memberId);
      }

      // 수업일지 "회원 확인"(상세 열람) — 위 readSessions(목록 노출만으로도 기록되는 배지 전용)와는 별개.
      // 회원 본인만 자기 확인 기록을 쓸 수 있고, 공개(isPublished)된 세션에만 쓸 수 있다(비공개 세션 열람 기록 방지).
      // firstReadAt/firstReadSource는 최초 생성 이후 절대 변경 불가 — update는 오직 lastReadAt/lastReadSource/readCount만 갱신 가능.
      match /sessionReads/{sessionId} {
        allow read: if isTrainerOfMember(memberId) || isMemberSelfActive(memberId);
        allow create: if isMemberSelfActive(memberId)
                      && get(/databases/$(database)/documents/members/$(memberId)/sessions/$(sessionId)).data.isPublished == true
                      && request.resource.data.keys().hasOnly(["sessionId", "memberId", "firstReadAt", "lastReadAt", "readCount", "firstReadSource", "lastReadSource"])
                      && request.resource.data.sessionId == sessionId
                      && request.resource.data.memberId == memberId
                      && request.resource.data.readCount == 1;
        allow update: if isMemberSelfActive(memberId)
                      && get(/databases/$(database)/documents/members/$(memberId)/sessions/$(sessionId)).data.isPublished == true
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastReadAt", "lastReadSource", "readCount"])
                      && request.resource.data.readCount == resource.data.readCount + 1;
        allow delete: if isTrainerOfMember(memberId);
      }

      // 회원 앱 이용 현황(관리자 전용 참고 지표) — 회원 본인은 자기 활동 데이터만 생성·갱신 가능, 읽기는 트레이너만 허용한다.
      // (회원앱 화면에 이 값을 절대 노출하지 않는 정책과 일치 — 회원 스스로도 자기 이용 기록을 조회할 수단을 주지 않는다)
      // firstUsedAt은 최초 생성 이후 변경 불가, memberId 위조 방지, 허용 필드 외 임의 필드 저장 방지.
      match /appUsage/{docId} {
        allow read: if isTrainerOfMember(memberId);
        allow create: if isMemberSelfActive(memberId)
                      && docId == "summary"
                      && request.resource.data.keys().hasOnly(["memberId", "firstUsedAt", "lastActiveAt", "lastActiveTab", "updatedAt"])
                      && request.resource.data.memberId == memberId;
        allow update: if isMemberSelfActive(memberId)
                      && docId == "summary"
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastActiveAt", "lastActiveTab", "updatedAt", "memberId"]);
        allow delete: if isTrainerOfMember(memberId);
      }

      // 회원 앱 "최근 30일 이용일 수" 계산 전용 — 문서 id(dateId)와 date 필드가 반드시 일치해야 하고, firstActiveAt/date는 생성 후 불변.
      match /appUsageDays/{dateId} {
        allow read: if isTrainerOfMember(memberId);
        allow create: if isMemberSelfActive(memberId)
                      && request.resource.data.keys().hasOnly(["date", "firstActiveAt", "lastActiveAt", "tabs"])
                      && request.resource.data.date == dateId;
        allow update: if isMemberSelfActive(memberId)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastActiveAt", "tabs"]);
        allow delete: if isTrainerOfMember(memberId);
      }

      match /noticeReads/{noticeId} {
        allow read: if canAccessMember(memberId);
        allow create, update: if isMemberSelfActive(memberId)
          && request.resource.data.noticeId == noticeId
          && request.resource.data.keys().hasOnly(["noticeId", "readAt"]);
        allow delete: if isTrainerOfMember(memberId);
      }

      match /bodyCheck/{docId} {
        allow read: if canAccessMember(memberId);
        allow create: if isTrainerOfMember(memberId)
                      || (isMemberSelfActive(memberId)
                          && docId == "main"
                          && bodyCheckProfileCreateKeysAllowed());
        allow update: if isTrainerOfMember(memberId)
                      || (isMemberSelfActive(memberId)
                          && docId == "main"
                          && bodyCheckProfileUpdateKeysAllowed());
        allow delete: if isTrainerOfMember(memberId);
      }

      match /assessments/{assessmentId} {
        allow read, write: if isTrainerOfMember(memberId);
      }

      // 체형평가(assessments)의 전문 임상 데이터는 그대로 트레이너 전용으로 두고,
      // 회원에게 보여줄 "교정 결과만" 별도로 복제 저장한 컬렉션 — 회원은 읽기만 가능(쓰기는 트레이너만)
      match /correctionSummaries/{summaryId} {
        allow read: if isTrainerOfMember(memberId) || isMemberSelfActive(memberId);
        allow write: if isTrainerOfMember(memberId);
      }

      match /nutrition/{docId} {
        allow read: if canAccessMember(memberId);
        allow write: if canAccessMember(memberId);
      }

      match /routineRecommendations/{recommendationId} {
        allow read: if isTrainerOfMember(memberId)
                    || (isMemberSelfActive(memberId) && isPublishedData(resource.data));
        allow create, update, delete: if isTrainerOfMember(memberId);
      }

      match /dailyConditioning/{conditioningId} {
        allow read: if isTrainerOfMember(memberId)
                    || (isMemberSelfActive(memberId) && isPublishedData(resource.data));
        allow create, update, delete: if isTrainerOfMember(memberId);
      }

      match /memberOnboarding/{docId} {
        allow read: if canAccessMember(memberId);
        allow create: if isTrainerOfMember(memberId)
                      || (isMemberSelfActive(memberId)
                          && docId == "main"
                          && memberOnboardingCreateKeysAllowed());
        allow update: if isTrainerOfMember(memberId)
                      || (isMemberSelfActive(memberId)
                          && docId == "main"
                          && memberOnboardingProfileKeysAllowed());
        allow delete: if isTrainerOfMember(memberId);
      }

      // 알림 배지 데이터 구조 — 운동일지/피드백/공지/식단 피드백 등 회원용 알림
      match /memberNotifications/{docId} {
        allow read: if canAccessMember(memberId);
        allow create: if isTrainerOfMember(memberId);
        allow update: if isTrainerOfMember(memberId)
                      || (isMemberSelfActive(memberId) && memberNotificationUpdateKeysAllowed());
        allow delete: if isTrainerOfMember(memberId);
      }

      // 명시적으로 매칭되지 않은 모든 서브컬렉션의 기본값 — private(memo/ticketInfo) 포함,
      // 화이트리스트에 없는 컬렉션은 전부 트레이너 전용으로 기본 차단(default-deny to non-trainer)
      match /{subCollection}/{docId} {
        allow read, write: if canWriteMemberPrivateData(memberId);
      }
    }

    // settings: 로그인 사용자 읽기 허용 (isVerifiedTrainer 함수에서 rules 내부 get() 사용)
    // 쓰기는 Firebase Console에서만 — 클라이언트 수정 불가
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // trainerNotificationReads: "오늘 회원 입력 피드" 읽음 상태 — 문서 id == 본인 uid일 때만 본인이 읽기/쓰기.
    // 회원 원본 데이터가 아니라 트레이너 개인의 알림 확인 여부만 담으므로 다른 규칙과 무관하게 독립적으로 존재.
    match /trainerNotificationReads/{uid} {
      allow read, write: if isSignedIn() && uid() == uid;
    }

    // exerciseClassifications: 센터 공통 운동 라이브러리(운동명→기구/부위/세부부위 마스터 데이터) — 문서 id == 본인 uid일 때만 본인이 읽기/쓰기.
    // 회원 데이터가 아니라 트레이너가 확인한 운동 분류만 담는다. 특정 회원이 아니라 트레이너(센터) 전체에 공통 적용된다.
    match /exerciseClassifications/{uid} {
      allow read, write: if isSignedIn() && uid() == uid;
    }

    match /dailyConditioning/{conditioningId} {
      allow read: if isSignedIn() && isPublishedData(resource.data);
      allow create, update: if isSignedIn() && request.resource.data.trainerUid == uid();
      allow delete: if isSignedIn() && resource.data.trainerUid == uid();
    }

    match /notices/{noticeId} {
      allow read: if isSignedIn()
        && (resource.data.get('trainerUid', '') == uid()
          || (resource.data.isPublished == true
            && (resource.data.targetType == "all"
              || (resource.data.targetType == "member"
                && isTargetMemberSelf(resource.data.targetMemberId)))));
      // create/update/delete: isVerifiedTrainer() 로 settings/trainers 목록 검증
      // → 회원 uid는 목록에 없으므로 차단, trainerUid 필드값 조작 불가
      allow create: if isSignedIn()
        && request.resource.data.get('trainerUid', '') == uid()
        && request.resource.data.get('createdBy', '') == uid()
        && isVerifiedTrainer();
      allow update: if isSignedIn()
        && resource.data.get('trainerUid', '') == uid()
        && request.resource.data.get('trainerUid', '') == uid()
        && isVerifiedTrainer();
      allow delete: if isSignedIn()
        && resource.data.get('trainerUid', '') == uid()
        && isVerifiedTrainer();

      // 공지 읽음 통계(관리자 조회용, §공지센터) — members/{memberId}/noticeReads(기존, 회원앱 미확인 배지 판별용)와는
      // 방향이 반대다. 관리자가 "이 공지를 누가 읽었는지"를 한 서브컬렉션 조회로 얻기 위해 notices 아래 별도로 둔다.
      // 회원은 자신의 읽음 기록만 생성·수정할 수 있고(다른 회원 몫 위조 불가), 조회는 트레이너 또는 본인만 가능하다.
      match /reads/{memberId} {
        allow read: if isSignedIn()
          && (get(/databases/$(database)/documents/notices/$(noticeId)).data.get('trainerUid', '') == uid()
            || isMemberSelfActive(memberId));
        allow create: if isMemberSelfActive(memberId)
          && request.resource.data.memberId == memberId
          && request.resource.data.authUid == uid()
          && request.resource.data.keys().hasOnly(["memberId", "memberNameSnapshot", "authUid", "firstReadAt", "lastReadAt", "readCount"])
          && request.resource.data.readCount == 1;
        allow update: if isMemberSelfActive(memberId)
          && resource.data.memberId == memberId
          && request.resource.data.memberId == memberId
          && request.resource.data.authUid == uid()
          && request.resource.data.firstReadAt == resource.data.firstReadAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastReadAt", "readCount", "memberNameSnapshot"])
          && request.resource.data.readCount == resource.data.readCount + 1;
        // 재공지(읽음 초기화) 시 관리자가 일괄 삭제할 수 있어야 한다 — trainerUid 일치만으로 게이트.
        allow delete: if isSignedIn()
          && get(/databases/$(database)/documents/notices/$(noticeId)).data.get('trainerUid', '') == uid();
      }
    }

    // consultations: 상담 고객(리드) — 등록 확정 전까지 members 문서를 만들지 않기 위한 트레이너 전용 컬렉션.
    // 회원 계정은 이 컬렉션에 접근할 이유가 전혀 없으므로 trainerUid 일치만으로 전부 게이트한다.
    match /consultations/{consultationId} {
      allow read: if isSignedIn() && resource.data.get('trainerUid', '') == uid();
      allow create: if isSignedIn() && request.resource.data.get('trainerUid', '') == uid();
      allow update: if isSignedIn()
        && resource.data.get('trainerUid', '') == uid()
        && request.resource.data.get('trainerUid', '') == uid();
      allow delete: if isSignedIn() && resource.data.get('trainerUid', '') == uid();
    }

    match /pairSessions/{pairSessionId} {
      allow read: if isSignedIn() && resource.data.get('trainerUid', '') == uid();
      // create/update/delete: trainerUid == uid() + members 컬렉션에서 실제 트레이너임을 검증
      // → 회원이 자신의 uid를 trainerUid로 설정해도 isTrainerOfMember() 에서 차단
      allow create: if isSignedIn()
        && request.resource.data.get('trainerUid', '') == uid()
        && isTrainerOfMember(request.resource.data.memberAId);
      allow update: if isSignedIn()
        && resource.data.get('trainerUid', '') == uid()
        && isTrainerOfMember(resource.data.memberAId);
      allow delete: if isSignedIn()
        && resource.data.get('trainerUid', '') == uid()
        && isTrainerOfMember(resource.data.memberAId);
    }
  }
}
